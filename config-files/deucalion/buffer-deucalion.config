env {
    LD_PRELOAD = "/mnt/bin/buffer_lib.so"
    BUFFER_PREFETCH_TARGETS = "dwidenoise,fslmaths,scil_image_math.py,scil_extract_b0.py,scil_extract_dwi_shell.py,mrconvert,mrcalc,mrthreshold,dwinormalise,mrdegibbs,bet,eddy_cpu,eddy_cuda,eddy_cuda10.2"
    BUFFER_WRITE_TARGETS = "dwidenoise,fslmaths,scil_image_math.py,scil_extract_b0.py,scil_extract_dwi_shell.py,mrconvert,mrcalc,mrthreshold,dwinormalise,mrdegibbs,bet,eddy_cpu,eddy_cuda,eddy_cuda10.2"
    BUFFER_LOG_FILE = "/mnt/buffer.log"
}

singularity.runOptions = "--no-home --bind /projects/I20240002/nunolxm/tractography-library/:/mnt:rw"

profiles {
    use_gpu {
        singularity.runOptions = "--nv --bind /projects/I20240002/nunolxm/tractography-library/:/mnt:rw"
    }
}