env {
    LD_PRELOAD = "/mnt/bin/buffer_lib.so"
    BUFFER_PREFETCH_TARGETS = "dwidenoise,fslmaths,mrconvert,mrcalc,mrthreshold,dwinormalise,mrdegibbs,bet,maskfilter,scil_extract_dwi_shell.py,scil_compute_dti_metrics.py,scil_extract_b0.py"
    BUFFER_WRITE_TARGETS = "dwidenoise,fslmaths,mrconvert,mrcalc,mrthreshold,dwinormalise,mrdegibbs,bet,maskfilter,scil_extract_dwi_shell.py,scil_compute_dti_metrics.py,scil_extract_b0.py"
    BUFFER_FILE_TARGETS = "*.nii,*.nii.gz,*_dwi*,*_dti*"
    BUFFER_LOG_FILE = "/mnt/x86-buffer-mgh8.log"
    BUFFER_WRITE_ENABLED = 1
    BUFFER_PREFETCH_ENABLED = 1
    BUFFER_WRITE_SIZE = 262144
    BUFFER_PREFETCH_SIZE = 262144
}


singularity.runOptions = "--no-home --bind /projects/I20240002/nunolxm/tractography-library/:/mnt:rw"

executor.queueSize = 1000

process {
    withLabel: 'big_mem' { maxForks = 999 }
}

profiles {
    use_gpu {
        singularity.runOptions = "--nv --bind /projects/I20240002/nunolxm/tractography-library/:/mnt:rw"
    }
}