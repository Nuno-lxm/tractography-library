// Layered after base.config: load buffer_lib with prefetching and write
// buffering. The run scripts turn write buffering off for --lib prefetch
env {
    LD_PRELOAD = "/mnt/bin/buffer_lib.so"
    BUFFER_PREFETCH_TARGETS = "dwidenoise,fslmaths,mrconvert,mrcalc,mrthreshold,dwinormalise,mrdegibbs,bet,maskfilter,scil_extract_dwi_shell.py,scil_compute_dti_metrics.py,scil_extract_b0.py,scil_resample_volume.py"
    BUFFER_WRITE_TARGETS = "dwidenoise,fslmaths,mrconvert,mrcalc,mrthreshold,dwinormalise,mrdegibbs,bet,maskfilter,scil_extract_dwi_shell.py,scil_compute_dti_metrics.py,scil_extract_b0.py,scil_resample_volume.py"
    BUFFER_FILE_TARGETS = "*.nii,*.nii.gz,*_dwi*,*_dti*"
    BUFFER_LOG_FILE = "/mnt/logs/buffer_${System.getenv('SLURM_JOB_ID') ?: 'nojob'}.log"
    BUFFER_WRITE_ENABLED = 1
    BUFFER_PREFETCH_ENABLED = 1
    BUFFER_WRITE_SIZE = 262144
    BUFFER_PREFETCH_SIZE = 262144
}
