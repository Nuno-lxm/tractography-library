env {
    LD_PRELOAD = "/mnt/bin/buffer_lib.so"
    BUFFER_WRITE_ENABLED = 1
    BUFFER_PREFETCH_ENABLED = 1
    BUFFER_WRITE_SIZE = 262144
    BUFFER_PREFETCH_SIZE = 262144
}

singularity.runOptions = "--no-home --bind /home/gsd/project/tractography-library/:/mnt:rw"

profiles {
    use_gpu {
        singularity.runOptions = "--nv --bind /home/gsd/project/tractography-library/:/mnt:rw"
    }
}